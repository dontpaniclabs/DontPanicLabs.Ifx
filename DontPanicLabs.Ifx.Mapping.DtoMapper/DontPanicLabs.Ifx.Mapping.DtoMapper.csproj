<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0</Version>
    <Title>Don't Panic Labs Dto Mapper</Title>
    <Description>A convention-based object-object mapper, forked from AutoMapper v14.0.0 (last MIT-licensed release).</Description>
    <Authors>Don't Panic Labs LLC</Authors>
    <Copyright>Copyright ⓒ Don't Panic Labs LLC 2026</Copyright>
    <PackageProjectUrl>https://github.com/dontpaniclabs/DontPanicLabs.Ifx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dontpaniclabs/DontPanicLabs.Ifx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>dpl_logo_128_square.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Assets\dpl_logo_128_square.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>dpl_logo_128_square.png</Link>
    </Content>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="THIRD-PARTY-NOTICES.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DontPanicLabs.Ifx.Mapping.Contracts\DontPanicLabs.Ifx.Mapping.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Linq.Expressions.Expression" Static="true" />
    <Using Include="DontPanicLabs.Ifx.Mapping.DtoMapper.Execution.ExpressionBuilder" Static="true" />
    <Using Include="DontPanicLabs.Ifx.Mapping.DtoMapper.Execution" />
    <Using Include="DontPanicLabs.Ifx.Mapping.DtoMapper.Configuration" />
  </ItemGroup>

</Project>
