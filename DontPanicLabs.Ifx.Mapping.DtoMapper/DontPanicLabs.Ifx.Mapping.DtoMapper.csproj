<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Title>Don't Panic Labs Dto Mapper</Title>
    <Description>A convention-based object-object mapper, forked from AutoMapper v14.0.0 (last MIT-licensed release).</Description>
    <Authors>Don't Panic Labs</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>DontPanicLabs.Ifx.Mapping.DtoMapper</AssemblyName>
    <PackageId>DontPanicLabs.Ifx.Mapping.DtoMapper</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" Visible="False" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DontPanicLabs.Ifx.Mapping.Contracts\DontPanicLabs.Ifx.Mapping.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Linq.Expressions.Expression" Static="true" />
    <Using Include="DontPanicLabs.Ifx.Mapping.DtoMapper.Execution.ExpressionBuilder" Static="true" />
    <Using Include="DontPanicLabs.Ifx.Mapping.DtoMapper.Execution" />
    <Using Include="DontPanicLabs.Ifx.Mapping.DtoMapper.Configuration" />
  </ItemGroup>

</Project>
